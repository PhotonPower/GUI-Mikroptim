# Umgebung für den Dienst gui-mikroptim (docs/betrieb.md, „Konfiguration“).
# Kopie nach ~/.config/gui-mikroptim/env, Pfade anpassen. Keine Geheimnisse hier eintragen.
MKO_GUI_PORT=8501
MKO_GUI_WORKSPACE=/home/benutzer/gui-mikroptim-daten
MKO_GUI_MIKROPTIM_REPO=/home/benutzer/src/Mikroptim
# MKO_GUI_CLI=/home/benutzer/src/Mikroptim/build/release-cuda/mikroptim
MKO_GUI_MAX_JOBS=1
# Sitzungsordner für mehrere Nutzer (ADR-0007); ohne diese Zeile ein gemeinsamer Arbeitsbereich
MKO_GUI_SESSIONS=/home/benutzer/gui-mikroptim-sitzungen
MKO_GUI_SESSION_DAYS=14
# CUDA-Laufzeit für das CUDA-Wheel, falls nicht systemweit gefunden
# LD_LIBRARY_PATH=/usr/local/cuda-12.9/lib64
